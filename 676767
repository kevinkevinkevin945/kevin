<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Obby 跑酷 · 第一人稱手榴彈</title>
<style>
  html,body{margin:0;height:100%;overflow:hidden;background:#070b16;
            font-family:system-ui,"Noto Sans TC",sans-serif;color:#e8eefc;cursor:default}
  canvas{display:block}

  /* 準星 */
  #crosshair{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);
             width:24px;height:24px;pointer-events:none;opacity:.85}
  #crosshair i{position:absolute;background:#7dd3fc;box-shadow:0 0 6px #38bdf8;border-radius:1px}
  #crosshair i:nth-child(1){left:50%;top:0;width:2px;height:9px;transform:translateX(-50%)}
  #crosshair i:nth-child(2){left:50%;bottom:0;width:2px;height:9px;transform:translateX(-50%)}
  #crosshair i:nth-child(3){top:50%;left:0;height:2px;width:9px;transform:translateY(-50%)}
  #crosshair i:nth-child(4){top:50%;right:0;height:2px;width:9px;transform:translateY(-50%)}

  /* HUD */
  #hud{position:fixed;left:16px;bottom:16px;font-size:13px;line-height:1.8;
       color:#9fb3d1;text-shadow:0 1px 3px #000;pointer-events:none}
  #hud b{color:#7dd3fc}
  #fuse{position:fixed;left:50%;bottom:60px;transform:translateX(-50%);
        font-size:15px;font-weight:700;letter-spacing:2px;color:#fca5a5;
        text-shadow:0 0 12px #ef4444;opacity:0;transition:opacity .1s;pointer-events:none}
  #goal{position:fixed;left:50%;top:22%;transform:translateX(-50%);
        font-size:42px;font-weight:900;color:#4ade80;text-shadow:0 0 30px #22c55e;
        opacity:0;transition:opacity .4s;pointer-events:none}

  /* 開始畫面 */
  #overlay{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;
           background:radial-gradient(circle at 50% 40%,#131c33,#05070f 70%);
           cursor:pointer;z-index:10;text-align:center}
  #overlay .card{max-width:520px;padding:36px 44px;border-radius:20px;
                 background:rgba(20,28,48,.75);border:1px solid rgba(125,211,252,.25);
                 box-shadow:0 0 60px rgba(56,189,248,.15)}
  #overlay h1{margin:0 0 6px;font-size:30px;letter-spacing:2px;color:#e0f2fe}
  #overlay p{margin:10px 0;color:#93a7c4;font-size:14px;line-height:1.9}
  kbd{display:inline-block;min-width:20px;padding:1px 7px;margin:0 2px;border-radius:5px;
      background:#1e293b;border:1px solid #334155;border-bottom-width:2px;
      color:#7dd3fc;font-size:12px;font-weight:700}
</style>
</head>
<body>

<div id="crosshair"><i></i><i></i><i></i><i></i></div>
<div id="hud">
  <div><b>WASD</b> 移動　<b>Space</b> 跳　<b>F</b> 丟手榴彈（1.8s 引爆）</div>
  <div>掉下去會回到起點 · 走到綠色終點平台</div>
</div>
<div id="fuse">⚠ 手榴彈 1.8 秒引爆</div>
<div id="goal">🏁 完成！</div>

<div id="overlay">
  <div class="card">
    <h1>OBBY 跑酷</h1>
    <p>第一人稱 · 物理手榴彈</p>
    <p><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> 移動　<kbd>Space</kbd> 跳躍<br>
       <kbd>F</kbd> 丟手榴彈（引信 1.8 秒，會把自己炸飛）<br>
       <kbd>點擊畫面</kbd> 鎖定滑鼠　<kbd>Esc</kbd> 解除</p>
    <p style="color:#4ade80;font-weight:700;margin-top:18px">▶ 點擊開始</p>
  </div>
</div>

<script type="importmap">
{
  "imports": {
    "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
    "cannon-es": "https://cdn.jsdelivr.net/npm/cannon-es@0.20.0/dist/cannon-es.js"
  }
}
</script>

<script type="module">
import * as THREE from 'three';
import * as CANNON from 'cannon-es';

/* ============================================================
   常數
   ============================================================ */
const GRAVITY      = 22;    // 遊戲重力
const FUSE_TIME    = 1.8;   // 手榴彈引信（秒）
const BLAST_RADIUS = 8;     // 爆炸半徑
const BLAST_POWER  = 26;    // 爆炸推力
const RESPAWN_Y    = -30;   // 掉到此高度重生

/* ============================================================
   場景 / 渲染器
   ============================================================ */
const scene = new THREE.Scene();
scene.background = new THREE.Color(0x070b16);
scene.fog = new THREE.FogExp2(0x070b16, 0.011);

const camera = new THREE.PerspectiveCamera(78, innerWidth / innerHeight, 0.05, 500);
camera.rotation.order = 'YXZ';

const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
renderer.setSize(innerWidth, innerHeight);
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
document.body.appendChild(renderer.domElement);

/* 燈光 */
scene.add(new THREE.HemisphereLight(0x8fb6ff, 0x1a1030, 1.0));

const sun = new THREE.DirectionalLight(0xffffff, 1.7);
sun.position.set(24, 46, 18);
sun.castShadow = true;
sun.shadow.mapSize.set(2048, 2048);
sun.shadow.camera.left = -70;
sun.shadow.camera.right = 70;
sun.shadow.camera.top = 70;
sun.shadow.camera.bottom = -70;
sun.shadow.camera.near = 1;
sun.shadow.camera.far = 220;
sun.shadow.bias = -0.0008;
scene.add(sun);

/* ============================================================
   物理世界（cannon-es）
   ============================================================ */
const world = new CANNON.World({ gravity: new CANNON.Vec3(0, -GRAVITY, 0) });
world.broadphase = new CANNON.SAPBroadphase(world);
world.allowSleep = true;
world.defaultContactMaterial.friction = 0.35;

const matGround  = new CANNON.Material('ground');
const matGrenade = new CANNON.Material('grenade');

world.addContactMaterial(new CANNON.ContactMaterial(matGround, matGrenade, {
  friction: 0.35,
  restitution: 0.45          // 手榴彈會彈跳
}));

/* ============================================================
   Obby 關卡（靜態方塊）
   ============================================================ */
const platforms = [];

function addBox(x, y, z, w, h, d, color) {
  const mesh = new THREE.Mesh(
    new THREE.BoxGeometry(w, h, d),
    new THREE.MeshStandardMaterial({ color, roughness: 0.72, metalness: 0.12 })
  );
  mesh.position.set(x, y, z);
  mesh.castShadow = true;
  mesh.receiveShadow = true;
  scene.add(mesh);

  // 邊線，讓跳台更清楚
  const edges = new THREE.LineSegments(
    new THREE.EdgesGeometry(mesh.geometry),
    new THREE.LineBasicMaterial({ color: 0x93c5fd, transparent: true, opacity: 0.35 })
  );
  mesh.add(edges);

  // 物理 body
  const body = new CANNON.Body({
    mass: 0,
    material: matGround,
    shape: new CANNON.Box(new CANNON.Vec3(w / 2, h / 2, d / 2))
  });
  body.position.set(x, y, z);
  world.addBody(body);

  platforms.push({
    mesh, body,
    pos:  new THREE.Vector3(x, y, z),
    half: new THREE.Vector3(w / 2, h / 2, d / 2)
  });
  return platforms[platforms.length - 1];
}

/* 關卡配置：[x, y, z, w, h, d, color] */
const course = [
  [ 0,  0.0,   0, 12, 1, 12, 0x2563eb],  // 起點
  [ 0,  0.6,  -9, 3.5, 1, 3.5, 0x38bdf8],
  [ 4.5,1.4, -13, 3.5, 1, 3.5, 0x38bdf8],
  [ 1.5,2.2,-17.5,3.5, 1, 3.5, 0x38bdf8],
  [-3,  3.0,-21.5,3.5, 1, 3.5, 0x38bdf8],
  [-3,  4.2, -27, 3.5, 1, 3.5, 0x38bdf8],
  [ 1.5,5.2, -31, 3.5, 1, 3.5, 0x38bdf8],
  [ 6,  6.2, -35, 3.5, 1, 3.5, 0x38bdf8],
  [ 6,  7.6, -40, 3.0, 1, 3.0, 0xa78bfa],
  [ 1,  9.0, -44, 3.0, 1, 3.0, 0xa78bfa],
  [-4, 10.2, -48, 3.0, 1, 3.0, 0xa78bfa],
  [ 0, 11.5, -54, 10,  1, 10,  0x22c55e], // 終點
];
course.forEach(c => addBox(...c));
const goalPlatform = platforms[platforms.length - 1];

/* ============================================================
   玩家（自訂 AABB 控制器）
   ============================================================ */
const SPAWN = new THREE.Vector3(0, 0.6, 3);

const player = {
  pos:      SPAWN.clone(),
  vel:      new THREE.Vector3(),   // 輸入／重力速度
  ext:      new THREE.Vector3(),   // 外力（爆炸擊退）
  yaw:      0,
  pitch:    0,
  radius:   0.4,
  height:   1.8,
  eye:      1.6,
  speed:    7.2,
  jumpSpeed:10.0,
  onGround: false
};

function respawn() {
  player.pos.copy(SPAWN);
  player.vel.set(0, 0, 0);
  player.ext.set(0, 0, 0);
  shake = 0.5;
}

/* 逐軸推出：解 AABB 與所有平台的重疊 */
function resolve(axis) {
  const r = player.radius, h = player.height;

  for (const p of platforms) {
    const { x: px, y: py, z: pz } = p.pos;
    const { x: hx, y: hy, z: hz } = p.half;

    // 快速排除
    if (player.pos.x - r >= px + hx || player.pos.x + r <= px - hx) continue;
    if (player.pos.y      >= py + hy || player.pos.y + h >= py - hy) continue;
    if (player.pos.z - r >= pz + hz || player.pos.z + r <= pz - hz) continue;

    if (axis === 'y') {
      const centerY = player.pos.y + h / 2;
      if (centerY > py) {                 // 站在上面
        player.pos.y = py + hy;
        if (player.vel.y < 0) player.vel.y = 0;
        if (player.ext.y < 0) player.ext.y = 0;
        player.onGround = true;
      } else {                            // 撞到頭
        player.pos.y = py - hy - h;
        if (player.vel.y > 0) player.vel.y = 0;
        if (player.ext.y > 0) player.ext.y = 0;
      }
    } else if (axis === 'x') {
      player.pos.x = player.pos.x > px ? px + hx + r : px - hx - r;
      player.vel.x = 0;
      player.ext.x = 0;
    } else {
      player.pos.z = player.pos.z > pz ? pz + hz + r : pz - hz - r;
      player.vel.z = 0;
      player.ext.z = 0;
    }
  }
}

/* ============================================================
   手榴彈
   ============================================================ */
const grenades = [];
let throwCooldown = 0;

const grenadeGeo = new THREE.IcosahedronGeometry(0.13, 1);
const grenadeMat = new THREE.MeshStandardMaterial({
  color: 0x3f4a2f, roughness: 0.85, metalness: 0.35,
  emissive: 0x112200, emissiveIntensity: 0.6
});
const coreGeo = new THREE.SphereGeometry(0.045, 10, 8);

function throwGrenade() {
  if (throwCooldown > 0) return;
  throwCooldown = 0.4;

  const dir = new THREE.Vector3();
  camera.getWorldDirection(dir);

  const spawn = new THREE.Vector3();
  camera.getWorldPosition(spawn);
  spawn.addScaledVector(dir, 0.7);

  // --- 物理 body ---
  const body = new CANNON.Body({
    mass: 0.5,
    shape: new CANNON.Sphere(0.13),
    material: matGrenade,
    linearDamping: 0.006,
    angularDamping: 0.12,
    allowSleep: true,
    sleepSpeedLimit: 0.35,
    sleepTimeLimit: 1.2
  });
  body.position.set(spawn.x, spawn.y, spawn.z);

  const POWER = 22;
  body.velocity.set(
    dir.x * POWER + player.vel.x + player.ext.x,
    dir.y * POWER + 1.5,
    dir.z * POWER + player.vel.z + player.ext.z
  );
  body.angularVelocity.set(
    (Math.random() - 0.5) * 22,
    (Math.random() - 0.5) * 22,
    (Math.random() - 0.5) * 22
  );
  world.addBody(body);

  // --- 視覺 ---
  const mesh = new THREE.Mesh(grenadeGeo, grenadeMat);
  const coreMat = new THREE.MeshBasicMaterial({ color: 0xff4422, transparent: true });
  const core = new THREE.Mesh(coreGeo, coreMat);
  core.position.set(0, 0.11, 0);
  mesh.add(core);
  mesh.castShadow = true;
  scene.add(mesh);

  grenades.push({ body, mesh, core, timer: FUSE_TIME });

  // 引信提示
  fuseEl.style.opacity = '1';
  clearTimeout(fuseTimer);
  fuseTimer = setTimeout(() => { fuseEl.style.opacity = '0'; }, FUSE_TIME * 1000);
}

let fuseTimer = null;
const fuseEl = document.getElementById('fuse');
const goalEl = document.getElementById('goal');

/* ============================================================
   爆炸
   ============================================================ */
const explosions = [];
let shake = 0;

function detonate(g) {
  const pos = new THREE.Vector3(g.body.position.x, g.body.position.y, g.body.position.z);

  // 移除物理體 + 網格
  world.removeBody(g.body);
  scene.remove(g.mesh);

  /* ---- 1. 對玩家擊退 ---- */
  const pc = new THREE.Vector3(
    player.pos.x,
    player.pos.y + player.height * 0.5,
    player.pos.z
  );
  const delta = pc.clone().sub(pos);
  const dist  = delta.length();

  if (dist < BLAST_RADIUS) {
    const falloff = 1 - dist / BLAST_RADIUS;
    const dir = dist > 0.01 ? delta.normalize() : new THREE.Vector3(0, 1, 0);
    dir.y = Math.max(dir.y, 0.35);   // 保證有上拋感
    dir.normalize();

    player.ext.addScaledVector(dir, BLAST_POWER * falloff);
    shake = Math.min(1.4, shake + 1.1 * falloff);
  }

  /* ---- 2. 衝擊波推開其他手榴彈 ---- */
  for (const other of grenades) {
    if (other === g) continue;
    const d = new THREE.Vector3(
      other.body.position.x - pos.x,
      other.body.position.y - pos.y,
      other.body.position.z - pos.z
    );
    const dd = d.length();
    if (dd < BLAST_RADIUS && dd > 0.001) {
      d.normalize().multiplyScalar(BLAST_POWER * 0.35 * (1 - dd / BLAST_RADIUS));
      other.body.applyImpulse(new CANNON.Vec3(d.x, d.y, d.z), new CANNON.Vec3(0, 0, 0));
    }
  }

  /* ---- 3. 視覺：閃光球 + 點光源 ---- */
  const ball = new THREE.Mesh(
    new THREE.SphereGeometry(0.5, 24, 16),
    new THREE.MeshBasicMaterial({
      color: 0xffb347, transparent: true, opacity: 0.95,
      blending: THREE.AdditiveBlending, depthWrite: false
    })
  );
  ball.position.copy(pos);
  scene.add(ball);

  const light = new THREE.PointLight(0xff8a3d, 120, 30, 2);
  light.position.copy(pos);
  scene.add(light);

  explosions.push({ ball, light, t: 0, dur: 0.55 });
}

/* ============================================================
   輸入
   ============================================================ */
const keys = {};
let locked = false;

const overlay = document.getElementById('overlay');

renderer.domElement.addEventListener('click', () => {
  renderer.domElement.requestPointerLock();
});

document.addEventListener('pointerlockchange', () => {
  locked = document.pointerLockElement === renderer.domElement;
  overlay.style.display = locked ? 'none' : 'flex';
});

document.addEventListener('mousemove', e => {
  if (!locked) return;
  player.yaw   -= e.movementX * 0.0022;
  player.pitch -= e.movementY * 0.0022;
  const lim = Math.PI / 2 - 0.05;
  player.pitch = Math.max(-lim, Math.min(lim, player.pitch));
});

addEventListener('keydown', e => {
  keys[e.code] = true;
  if (e.code === 'Space') e.preventDefault();
  if (e.code === 'KeyF' && !e.repeat) throwGrenade();
});
addEventListener('keyup', e => { keys[e.code] = false; });

addEventListener('resize', () => {
  camera.aspect = innerWidth / innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
});

/* ============================================================
   主迴圈
   ============================================================ */
const clock = new THREE.Clock();
let goalShown = false;

function update(dt) {
  throwCooldown = Math.max(0, throwCooldown - dt);

  /* ---------- 玩家：輸入 ---------- */
  const s = Math.sin(player.yaw), c = Math.cos(player.yaw);
  const fwd   = new THREE.Vector3(-s, 0, -c);
  const right = new THREE.Vector3( c, 0, -s);

  const wish = new THREE.Vector3();
  if (keys['KeyW'] || keys['ArrowUp'])    wish.add(fwd);
  if (keys['KeyS'] || keys['ArrowDown'])  wish.sub(fwd);
  if (keys['KeyD'] || keys['ArrowRight']) wish.add(right);
  if (keys['KeyA'] || keys['ArrowLeft'])  wish.sub(right);
  if (wish.lengthSq() > 0) wish.normalize();

  const k = player.onGround ? 14 : 2.6;
  player.vel.x = THREE.MathUtils.damp(player.vel.x, wish.x * player.speed, k, dt);
  player.vel.z = THREE.MathUtils.damp(player.vel.z, wish.z * player.speed, k, dt);

  /* ---------- 跳躍 ---------- */
  if (keys['Space'] && player.onGround) {
    player.vel.y = player.jumpSpeed;
    player.onGround = false;
  }

  /* ---------- 重力 / 外力衰減 ---------- */
  player.vel.y -= GRAVITY * dt;
  if (player.vel.y < -60) player.vel.y = -60;
  player.ext.multiplyScalar(Math.exp(-2.6 * dt));

  /* ---------- 移動 + 碰撞解算 ---------- */
  const vx = (player.vel.x + player.ext.x) * dt;
  const vz = (player.vel.z + player.ext.z) * dt;
  const vy = (player.vel.y + player.ext.y) * dt;

  player.onGround = false;

  player.pos.x += vx; resolve('x');
  player.pos.z += vz; resolve('z');
  player.pos.y += vy; resolve('y');

  if (player.pos.y < RESPAWN_Y) respawn();

  /* ---------- 抵達終點 ---------- */
  if (!goalShown) {
    const g = goalPlatform;
    if (player.pos.y >= g.pos.y + g.half.y - 0.1 &&
        Math.abs(player.pos.x - g.pos.x) < g.half.x &&
        Math.abs(player.pos.z - g.pos.z) < g.half.z) {
      goalShown = true;
      goalEl.style.opacity = '1';
      setTimeout(() => { goalEl.style.opacity = '0'; goalShown = false; }, 2500);
    }
  }

  /* ---------- 手榴彈引信 ---------- */
  for (let i = grenades.length - 1; i >= 0; i--) {
    const g = grenades[i];
    g.timer -= dt;

    // 快爆炸時核心紅點閃爍
    const blink = g.timer < 1.0
      ? (Math.sin(g.timer * 55) > 0 ? 1 : 0.15)
      : 0.9;
    g.core.material.opacity = blink;
    g.core.scale.setScalar(0.7 + blink * 0.8);

    if (g.timer <= 0) {
      detonate(g);
      grenades.splice(i, 1);
    }
  }

  /* ---------- 物理世界步進 ---------- */
  world.step(1 / 60, dt, 3);

  // 同步手榴彈網格
  for (const g of grenades) {
    g.mesh.position.copy(g.body.position);
    g.mesh.quaternion.copy(g.body.quaternion);
  }

  /* ---------- 爆炸視覺更新 ---------- */
  for (let i = explosions.length - 1; i >= 0; i--) {
    const ex = explosions[i];
    ex.t += dt;
    const p = ex.t / ex.dur;

    if (p >= 1) {
      scene.remove(ex.ball);
      scene.remove(ex.light);
      ex.ball.geometry.dispose();
      ex.ball.material.dispose();
      explosions.splice(i, 1);
      continue;
    }

    const scale = 1 + p * 9;
    ex.ball.scale.setScalar(scale);
    ex.ball.material.opacity = 0.95 * (1 - p) * (1 - p);
    ex.light.intensity = 120 * (1 - p) * (1 - p);
  }

  /* ---------- 相機 ---------- */
  camera.position.set(
    player.pos.x,
    player.pos.y + player.eye,
    player.pos.z
  );
  camera.rotation.y = player.yaw;
  camera.rotation.x = player.pitch;

  if (shake > 0.0005) {
    camera.position.x += (Math.random() - 0.5) * shake * 0.35;
    camera.position.y += (Math.random() - 0.5) * shake * 0.35;
    camera.position.z += (Math.random() - 0.5) * shake * 0.35;
    camera.rotation.z = (Math.random() - 0.5) * shake * 0.06;
    shake *= Math.exp(-7 * dt);
  } else {
    shake = 0;
    camera.rotation.z = 0;
  }
}

function animate() {
  requestAnimationFrame(animate);
  const dt = Math.min(clock.getDelta(), 0.05);
  update(dt);
  renderer.render(scene, camera);
}

animate();
</script>
</body>
</html>
