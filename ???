<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>智慧安全加解密系統</title>
    
    <!-- 🕵️‍♂️ 設定分頁圖標 -->
    <link rel="icon" href="unnamed.jpg" type="image/jpeg">

    <style>
        body {
            font-family: 'Segoe UI', Microsoft JhengHei, Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f7f6;
            color: #333;
            max-width: 600px;
            margin: 40px auto;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            background: #fff;
        }
        h2 { text-align: center; color: #2c3e50; }
        .form-group { margin-bottom: 15px; }
        label { display: block; margin-bottom: 5px; font-weight: bold; }
        input[type="text"], input[type="password"], textarea, select {
            width: 100%;
            padding: 10px;
            box-sizing: border-box;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 16px;
        }
        textarea { height: 100px; resize: vertical; }
        .btn-group { display: flex; gap: 10px; margin-top: 10px; }
        button {
            flex: 1;
            padding: 12px;
            border: none;
            border-radius: 4px;
            color: white;
            font-size: 16px;
            cursor: pointer;
            transition: background 0.2s;
        }
        .btn-encode { background-color: #3498db; }
        .btn-encode:hover { background-color: #2980b9; }
        .btn-decode { background-color: #2ecc71; }
        .btn-decode:hover { background-color: #27ae60; }
        .btn-copy { background-color: #e67e22; }
        .btn-copy:hover { background-color: #d35400; }
        .btn-verify { background-color: #9b59b6; margin-top: 10px; width: 100%; }
        .btn-verify:hover { background-color: #8e44ad; }
        
        .admin-box {
            background-color: #fce4ec;
            border: 1px solid #f8bbd0;
            padding: 15px;
            border-radius: 6px;
            margin-bottom: 15px;
        }
        .btn-admin-save { background-color: #e74c3c; margin-top: 8px; width: 100%; }
        .btn-admin-save:hover { background-color: #c0392b; }
        .btn-change-pw { background-color: #34495e; margin-top: 5px; width: 100%; }
        .btn-change-pw:hover { background-color: #2c3e50; }
        
        .hidden { display: none !important; }
        .permission-box {
            background-color: #eef7fc;
            padding: 15px;
            border-radius: 6px;
            border: 1px solid #bce8f1;
            margin-bottom: 15px;
        }
        .decrypt-box {
            background-color: #eef9f1;
            padding: 12px;
            border-radius: 6px;
            border: 1px solid #c3e6cb;
            margin-top: 10px;
        }
        .user-setting-box {
            background-color: #f8f9fa;
            border: 1px dashed #ccc;
            padding: 15px;
            border-radius: 6px;
            margin-top: 20px;
        }
    </style>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/9.23.0/firebase-app.js";
        import { getDatabase, ref, get, child, set } from "https://www.gstatic.com/firebasejs/9.23.0/firebase-database.js";

        const firebaseConfig = {
            databaseURL: "https://kevin-73684-default-rtdb.firebaseio.com",
            projectId: "kevin-73684"
        };

        const app = initializeApp(firebaseConfig);
        const db = getDatabase(app);

        const DEFAULT_PASSWORDS = {
            "0": "kevinisbabybear@Kevin945",
            "1": "userpass1", 
            "2": "userpass2",  
            "3": "userpass3",
            "4": "userpass4",
            "5": "userpass5",
            "6": "userpass6",
            "7": "userpass7",
            "8": "userpass8"
        };

        const DEFAULT_NAMES = {
            "0": "管理員(Kevin)",
            "1": "成員1(Lily)",
            "2": "成員2(Emily)",
            "3": "成員3",
            "4": "成員4",
            "5": "成員5",
            "6": "成員6",
            "7": "成員7",
            "8": "成員8"
        };

        // 讀取/初始化 密碼
        window.getCloudPasswords = async function() {
            try {
                const dbRef = ref(db);
                const snapshot = await get(child(dbRef, "SYSTEM_MEMBER_KEYS"));
                if (snapshot.exists()) return snapshot.val();
                await set(ref(db, "SYSTEM_MEMBER_KEYS"), DEFAULT_PASSWORDS);
                return DEFAULT_PASSWORDS;
            } catch (error) {
                console.error("雲端密碼讀取失敗:", error);
                return DEFAULT_PASSWORDS;
            }
        };

        window.updateCloudPasswords = async function(newPasswords) {
            try {
                await set(ref(db, "SYSTEM_MEMBER_KEYS"), newPasswords);
                return true;
            } catch (error) {
                console.error("雲端密碼更新失敗:", error);
                return false;
            }
        };

        // 讀取/初始化 名字
        window.getCloudNames = async function() {
            try {
                const dbRef = ref(db);
                const snapshot = await get(child(dbRef, "SYSTEM_MEMBER_NAMES"));
                if (snapshot.exists()) return snapshot.val();
                await set(ref(db, "SYSTEM_MEMBER_NAMES"), DEFAULT_NAMES);
                return DEFAULT_NAMES;
            } catch (error) {
                console.error("雲端名稱讀取失敗:", error);
                return DEFAULT_NAMES;
            }
        };

        window.updateCloudNames = async function(newNames) {
            try {
                await set(ref(db, "SYSTEM_MEMBER_NAMES"), newNames);
                return true;
            } catch (error) {
                console.error("雲端名稱更新失敗:", error);
                return false;
            }
        };
    </script>
</head>
<body>

    <h2>🔐 加解密系統</h2>

    <div id="authBlock" class="form-group">
        <label for="userKey">🔑 請輸入存取安全金鑰密碼：</label>
        <input type="password" id="userKey" placeholder="請輸入您的金鑰密碼...">
        <button class="btn-verify" onclick="verifyPassword()">🔓 登入系統</button>
    </div>

    <div id="mainBlock" class="hidden">
        
        <!-- 👑 管理員控制台 -->
        <div id="adminControlBox" class="admin-box hidden">
            <label>👑 <b>管理員控制台：修改任意成員資訊</b></label>
            <div style="display: flex; gap: 10px; margin-top: 8px;">
                <select id="adminTargetSelect" style="flex: 1;" onchange="loadSelectedMemberInfo()">
                </select>
                <input type="text" id="adminNewNameInput" style="flex: 1;" placeholder="該成員新名稱...">
                <input type="text" id="adminNewPassInput" style="flex: 1;" placeholder="該成員新密碼...">
            </div>
            <button class="btn-admin-save" onclick="adminChangeMemberInfo()">💾 儲存變更至雲端</button>
        </div>
          
        <div class="form-group">
            <label for="inputText">📝 輸入文字（加密或解密內文）：</label>
            <textarea id="inputText" placeholder="加密：輸入要加密的文字&#10;解密：貼上密文..."></textarea>
        </div>

        <div class="permission-box">
            <label for="accessScope">🎯 選擇誰可以解密這段密文：</label>
            <select id="accessScope" onchange="toggleTargetSelect()">
                <option value="self">🔒 僅我自己可解密</option>
                <option value="public">🌐 開放所有人（大家都可以解密）</option>
                <option value="specific">👤 指定特定成員解密...</option>
            </select>

            <div id="targetMemberGroup" class="hidden" style="margin-top: 10px;">
                <label for="targetMemberSelect">👥 請選擇指定接收者：</label>
                <select id="targetMemberSelect">
                </select>
            </div>
        </div>

        <!-- 🔑 解密專用金鑰輸入區 -->
        <div class="decrypt-box">
            <label for="decryptCustomKey">🔑 解密專用金鑰（解密時若對方有自訂金鑰請填寫，留空則自動使用目前登入金鑰）：</label>
            <input type="password" id="decryptCustomKey" placeholder="非必填：特定自訂金鑰請在此輸入...">
        </div>

        <div class="btn-group">
            <button class="btn-encode" onclick="encodeProcess()">加密</button>
            <button class="btn-decode" onclick="decodeProcess()">解密</button>
        </div>

        <div class="form-group" style="margin-top: 20px;">
            <label for="outputText">✨ 輸出結果：</label>
            <textarea id="outputText" readonly placeholder="結果會顯示在這裡..."></textarea>
        </div>

        <button class="btn-copy" onclick="copyResult()">📋 一鍵複製結果</button>
        
        <!-- 🛠️ 個人帳號設定區 -->
        <div class="user-setting-box">
            <label>🏷️ <b>變更您的顯示名稱</b></label>
            <div style="display: flex; gap: 10px; margin-top: 5px; margin-bottom: 15px;">
                <input type="text" id="newDisplayNameInput" placeholder="輸入新的顯示名稱...">
                <button class="btn-change-pw" style="flex:0.4; margin:0;" onclick="changeMyName()">💾 更新名字</button>
            </div>

            <label>🛠️ <b>修改【您自己】目前的專屬金鑰密碼</b></label>
            <input type="password" id="newPasswordInput" placeholder="輸入想要變更的新密碼...">
            <button class="btn-change-pw" onclick="changeMyPassword()">💾 確認修改密碼並同步至雲端</button>
        </div>
    </div>

<script>
const SUPER_ADMIN_KEY = "kevinisbabybear@Kevin945";

let currentRole = "user"; 
let loggedInPrefix = "";
let savedRawKey = "";    
let currentCloudPasswords = {};
let currentCloudNames = {};

async function verifyPassword() {
    const inputKey = document.getElementById('userKey').value.trim();
    if (!inputKey) {
        alert("⚠️ 請先輸入金鑰密碼！");
        return;
    }

    currentCloudPasswords = await window.getCloudPasswords();
    currentCloudNames = await window.getCloudNames();
    savedRawKey = inputKey;

    if (inputKey === SUPER_ADMIN_KEY) {
        currentRole = "admin";
        loggedInPrefix = "0";
        document.getElementById('authBlock').classList.add('hidden'); 
        document.getElementById('mainBlock').classList.remove('hidden'); 
        document.getElementById('adminControlBox').classList.remove('hidden'); 
        
        populateAdminDropdown();
        populateMemberDropdown();
        alert("👑 最高管理員登入成功！擁有全域解碼權限力。");
    } else {
        const matchedPrefix = Object.keys(currentCloudPasswords).find(prefix => currentCloudPasswords[prefix] === inputKey);
        if (matchedPrefix) {
            currentRole = "user";
            loggedInPrefix = matchedPrefix;
            document.getElementById('authBlock').classList.add('hidden'); 
            document.getElementById('mainBlock').classList.remove('hidden'); 
            populateMemberDropdown();
            
            // 預載目前名稱到設定框
            document.getElementById('newDisplayNameInput').value = currentCloudNames[loggedInPrefix] || "";
            let displayName = currentCloudNames[loggedInPrefix] || `成員 ${loggedInPrefix}`;
            alert(`🔓 登入成功！身分：[${displayName}]`);
        } else {
            alert("❌ 密碼驗證失敗！請確認輸入是否正確。");
        }
    }
}

function populateMemberDropdown() {
    const select = document.getElementById('targetMemberSelect');
    select.innerHTML = "";
    
    for (const [prefix, name] of Object.entries(currentCloudNames)) {
        if (prefix !== loggedInPrefix) {
            const opt = document.createElement('option');
            opt.value = prefix;
            opt.textContent = name;
            select.appendChild(opt);
        }
    }
}

function populateAdminDropdown() {
    const select = document.getElementById('adminTargetSelect');
    select.innerHTML = "";
    
    for (const [prefix, name] of Object.entries(currentCloudNames)) {
        if (prefix !== "0") {
            const opt = document.createElement('option');
            opt.value = prefix;
            opt.textContent = name;
            select.appendChild(opt);
        }
    }
    loadSelectedMemberInfo();
}

function loadSelectedMemberInfo() {
    const selectVal = document.getElementById('adminTargetSelect').value;
    if (selectVal) {
        if (currentCloudPasswords[selectVal]) {
            document.getElementById('adminNewPassInput').value = currentCloudPasswords[selectVal];
        }
        if (currentCloudNames[selectVal]) {
            document.getElementById('adminNewNameInput').value = currentCloudNames[selectVal];
        }
    }
}

// 👑 管理員修改成員名字與密碼
async function adminChangeMemberInfo() {
    if (currentRole !== "admin") return;
    const targetMember = document.getElementById('adminTargetSelect').value;
    const newName = document.getElementById('adminNewNameInput').value.trim();
    const newPass = document.getElementById('adminNewPassInput').value.trim();

    if (!newName || !newPass) {
        alert("⚠️ 名稱與密碼皆不可為空白！");
        return;
    }

    currentCloudNames[targetMember] = newName;
    currentCloudPasswords[targetMember] = newPass;

    const p1 = window.updateCloudNames(currentCloudNames);
    const p2 = window.updateCloudPasswords(currentCloudPasswords);

    if (await p1 && await p2) {
        populateAdminDropdown();
        populateMemberDropdown();
        alert(`🎉 已成功將成員【${targetMember}】變更為：\n名稱：${newName}\n密碼：${newPass}`);
    }
}

// 👤 個人變更顯示名稱
async function changeMyName() {
    const newName = document.getElementById('newDisplayNameInput').value.trim();
    if (!newName) {
        alert("⚠️ 請輸入想要設定的名詞！");
        return;
    }

    currentCloudNames[loggedInPrefix] = newName;
    const success = await window.updateCloudNames(currentCloudNames);
    if (success) {
        populateMemberDropdown();
        alert(`🎉 您的名稱已成功修改為：「${newName}」並同步至雲端！`);
    }
}

// 👤 個人修改密碼
async function changeMyPassword() {
    const newPass = document.getElementById('newPasswordInput').value.trim();
    if (!newPass) {
        alert("⚠️ 請輸入新密碼！");
        return;
    }

    if (currentRole === "admin") {
        alert("⚠️ 最高管理員金鑰無法透過此處修改。");
        return;
    }

    if (loggedInPrefix && currentCloudPasswords[loggedInPrefix] !== undefined) {
        currentCloudPasswords[loggedInPrefix] = newPass;
        const success = await window.updateCloudPasswords(currentCloudPasswords);
        if (success) {
            savedRawKey = newPass; 
            document.getElementById('newPasswordInput').value = "";
            alert("🎉 您的新密碼已成功更新並寫入雲端！");
        }
    }
}

function toggleTargetSelect() {
    const scope = document.getElementById('accessScope').value;
    const targetGroup = document.getElementById('targetMemberGroup');
    if (scope === 'specific') {
        targetGroup.classList.remove('hidden');
    } else {
        targetGroup.classList.add('hidden');
    }
}

// 🛡️ PBKDF2 金鑰衍生
async function deriveKey(password, salt) {
    const enc = new TextEncoder();
    const keyMaterial = await window.crypto.subtle.importKey(
        "raw",
        enc.encode(password),
        { name: "PBKDF2" },
        false,
        ["deriveKey"]
    );
    return window.crypto.subtle.deriveKey(
        {
            name: "PBKDF2",
            salt: salt,
            iterations: 100000,
            hash: "SHA-256"
        },
        keyMaterial,
        { name: "AES-GCM", length: 256 },
        false,
        ["encrypt", "decrypt"]
    );
}

// 🔒 加密處理 (包含管理員備份密碼包裹)
async function encodeProcess() {
    const input = document.getElementById('inputText').value.trim();
    if (!input) {
        alert("⚠️ 請先輸入要加密的內容！");
        return;
    }

    currentCloudPasswords = await window.getCloudPasswords();
    const scope = document.getElementById('accessScope').value;
    let targetKey = "";

    if (scope === "self") {
        targetKey = savedRawKey;
    } else if (scope === "public") {
        targetKey = "PUBLIC_BROADCAST_KEY_2026";
    } else if (scope === "specific") {
        const targetPrefix = document.getElementById('targetMemberSelect').value;
        targetKey = (targetPrefix === "0") ? SUPER_ADMIN_KEY : currentCloudPasswords[targetPrefix];
        if (!targetKey) {
            alert("⚠️ 找不到該目標對象的金鑰！");
            return;
        }
    }

    try {
        const enc = new TextEncoder();
        const salt = window.crypto.getRandomValues(new Uint8Array(16));
        const iv = window.crypto.getRandomValues(new Uint8Array(12));
        
        // 1. 使用目標對象金鑰加密內文
        const cryptoKey = await deriveKey(targetKey, salt);
        const encryptedContent = await window.crypto.subtle.encrypt(
            { name: "AES-GCM", iv: iv },
            cryptoKey,
            enc.encode(input)
        );

        // 2. 👑 管理員後門解密專用：用最高管理員金鑰額外加密一份
        const adminCryptoKey = await deriveKey(SUPER_ADMIN_KEY, salt);
        const adminEncryptedContent = await window.crypto.subtle.encrypt(
            { name: "AES-GCM", iv: iv },
            adminCryptoKey,
            enc.encode(input)
        );

        // 封裝數據 structure: [Salt(16)] + [IV(12)] + [AdminPayloadLen(4)] + [AdminPayload] + [UserPayload]
        const adminLen = adminEncryptedContent.byteLength;
        const combined = new Uint8Array(16 + 12 + 4 + adminLen + encryptedContent.byteLength);
        
        combined.set(salt, 0);
        combined.set(iv, 16);
        
        // 寫入 AdminPayload 長度
        combined[28] = (adminLen >> 24) & 0xFF;
        combined[29] = (adminLen >> 16) & 0xFF;
        combined[30] = (adminLen >> 8) & 0xFF;
        combined[31] = adminLen & 0xFF;

        combined.set(new Uint8Array(adminEncryptedContent), 32);
        combined.set(new Uint8Array(encryptedContent), 32 + adminLen);

        const base64Cipher = btoa(String.fromCharCode(...combined));
        document.getElementById('outputText').value = base64Cipher;
    } catch (e) {
        console.error(e);
        alert("❌ 加密失敗！");
    }
}

// 🔓 解密處理
async function decodeProcess() {
    const input = document.getElementById('inputText').value.trim();
    if (!input) {
        alert("⚠️ 請先貼上要解密的密文！");
        return;
    }

    const customKey = document.getElementById('decryptCustomKey').value.trim();
    let candidateKeys = [];

    // 若登入者為管理員，優先放入超級金鑰，達成全視角解讀
    if (currentRole === "admin") {
        candidateKeys.push(SUPER_ADMIN_KEY);
    }
    if (customKey) {
        candidateKeys.push(customKey);
    }
    candidateKeys.push(savedRawKey, "PUBLIC_BROADCAST_KEY_2026");

    try {
        const combined = new Uint8Array(atob(input).split("").map(c => c.charCodeAt(0)));
        if (combined.length < 32) {
            throw new Error("Invalid cipher length");
        }

        const salt = combined.slice(0, 16);
        const iv = combined.slice(16, 28);
        
        const adminLen = (combined[28] << 24) | (combined[29] << 16) | (combined[30] << 8) | combined[31];
        const adminData = combined.slice(32, 32 + adminLen);
        const userData = combined.slice(32 + adminLen);

        let decryptedText = null;

        for (const keyCandidate of candidateKeys) {
            try {
                const cryptoKey = await deriveKey(keyCandidate, salt);
                
                // 優先解析 User 區域，若失敗（代表是管理員在監看）則嘗試解析 Admin 區域
                try {
                    const decryptedContent = await window.crypto.subtle.decrypt(
                        { name: "AES-GCM", iv: iv },
                        cryptoKey,
                        userData
                    );
                    decryptedText = new TextDecoder().decode(decryptedContent);
                    break;
                } catch (e) {
                    const decryptedContent = await window.crypto.subtle.decrypt(
                        { name: "AES-GCM", iv: iv },
                        cryptoKey,
                        adminData
                    );
                    decryptedText = new TextDecoder().decode(decryptedContent);
                    break;
                }
            } catch (err) {
                // 金鑰不符合繼續嘗試
            }
        }

        if (decryptedText !== null) {
            document.getElementById('outputText').value = decryptedText;
            alert("🔓 金鑰驗證通過，解密成功！");
        } else {
            alert("❌ 解密失敗：金鑰不正確或您沒有閱讀這段密文的權限！");
            document.getElementById('outputText').value = "❌ 金鑰錯誤，無法還原密文";
        }
    } catch (e) {
        alert("❌ 解密失敗：密文格式不正確或已被篡改！");
        document.getElementById('outputText').value = "❌ 密文格式錯誤";
    }
}

function copyResult() {
    const outputText = document.getElementById('outputText');
    if (!outputText.value) { 
        alert("⚠️ 目前沒有任何結果可以複製！"); 
        return; 
    }
    outputText.select();
    navigator.clipboard.writeText(outputText.value).then(() => alert("📋 已成功複製到剪貼簿！"));
}
</script>
</body>
</html>
