<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>靶場準心訓練遊戲</title>
    <style>
        * {
            box-sizing: border-box;
            user-select: none;
        }
        body {
            margin: 0;
            padding: 0;
            background-color: #1a1a1a;
            color: #ffffff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            overflow: hidden;
        }
        #game-container {
            position: relative;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8);
            border-radius: 8px;
            overflow: hidden;
            border: 2px solid #333;
        }
        #hud {
            position: absolute;
            top: 15px;
            left: 20px;
            right: 20px;
            display: flex;
            justify-content: space-between;
            font-size: 20px;
            font-weight: bold;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
            pointer-events: none;
            z-index: 10;
        }
        canvas {
            display: block;
            background: radial-gradient(circle, #2c3e50 0%, #000000 100%);
            cursor: none; /* 隱藏原生滑鼠游標 */
        }
        #start-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 20;
        }
        h1 {
            margin-bottom: 10px;
            color: #00ffcc;
            letter-spacing: 2px;
        }
        p {
            color: #cccccc;
            margin-bottom: 25px;
        }
        .btn {
            padding: 12px 30px;
            font-size: 18px;
            font-weight: bold;
            color: #1a1a1a;
            background-color: #00ffcc;
            border: none;
            border-radius: 25px;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .btn:hover {
            background-color: #00cca3;
            transform: scale(1.05);
        }
    </style>
</head>
<body>

<div id="game-container">
    <div id="hud">
        <div>得分: <span id="score">0</span></div>
        <div>剩餘時間: <span id="timer">30</span> 秒</div>
    </div>
    
    <canvas id="gameCanvas" width="800" height="500"></canvas>

    <div id="start-overlay">
        <h1 id="title-text">狙擊靶場訓練</h1>
        <p id="sub-text">移動滑鼠瞄準，點擊左鍵擊中目標靶！</p>
        <button class="btn" id="start-btn" onclick="startGame()">開始遊戲</button>
    </div>
</div>

<script>
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const scoreEl = document.getElementById('score');
    const timerEl = document.getElementById('timer');
    const overlay = document.getElementById('start-overlay');
    const titleText = document.getElementById('title-text');
    const startBtn = document.getElementById('start-btn');

    let score = 0;
    let timeLeft = 30;
    let gameInterval = null;
    let timerInterval = null;
    let isPlaying = false;

    // 滑鼠位置
    const mouse = { x: canvas.width / 2, y: canvas.height / 2 };

    // 目標靶設定
    let targets = [];
    const targetCount = 3;

    class Target {
        constructor() {
            this.reset();
        }

        reset() {
            this.radius = Math.random() * 12 + 18; // 靶的大小
            this.x = Math.random() * (canvas.width - this.radius * 2) + this.radius;
            this.y = Math.random() * (canvas.height - this.radius * 2) + this.radius;
            this.vx = (Math.random() - 0.5) * 4; // 移動速度 X
            this.vy = (Math.random() - 0.5) * 4; // 移動速度 Y
        }

        update() {
            this.x += this.vx;
            this.y += this.vy;

            // 碰到邊界反彈
            if (this.x - this.radius < 0 || this.x + this.radius > canvas.width) this.vx *= -1;
            if (this.y - this.radius < 0 || this.y + this.radius > canvas.height) this.vy *= -1;
        }

        draw() {
            // 繪製多層靶心（紅白相間）
            const rings = [1, 0.7, 0.4, 0.15];
            const colors = ['#e74c3c', '#ffffff', '#e74c3c', '#ffff00'];

            for (let i = 0; i < rings.length; i++) {
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.radius * rings[i], 0, Math.PI * 2);
                ctx.fillStyle = colors[i];
                ctx.fill();
                ctx.closePath();
            }
        }
    }

    // 更新滑鼠座標
    canvas.addEventListener('mousemove', (e) => {
        const rect = canvas.getBoundingClientRect();
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
    });

    // 點擊射擊
    canvas.addEventListener('mousedown', () => {
        if (!isPlaying) return;

        // 檢查是否命中任何靶
        for (let target of targets) {
            const dist = Math.hypot(mouse.x - target.x, mouse.y - target.y);
            if (dist < target.radius) {
                score += 100;
                scoreEl.textContent = score;
                target.reset(); // 擊中後重置目標位置
                break;
            }
        }
    });

    function drawCrosshair() {
        const x = mouse.x;
        const y = mouse.y;

        // 狙擊鏡外圍圓圈
        ctx.strokeStyle = '#00ffcc';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(x, y, 25, 0, Math.PI * 2);
        ctx.stroke();

        // 準心十字線
        ctx.strokeStyle = 'rgba(0, 255, 204, 0.8)';
        ctx.lineWidth = 1.5;
        
        ctx.beginPath();
        ctx.moveTo(x - 35, y); ctx.lineTo(x - 10, y);
        ctx.moveTo(x + 10, y); ctx.lineTo(x + 35, y);
        ctx.moveTo(x, y - 35); ctx.lineTo(x, y - 10);
        ctx.moveTo(x, y + 10); ctx.lineTo(x, y + 35);
        ctx.stroke();

        // 中心點
        ctx.fillStyle = '#ff0055';
        ctx.beginPath();
        ctx.arc(x, y, 2, 0, Math.PI * 2);
        ctx.fill();
    }

    function gameLoop() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // 更新與繪製目標
        targets.forEach(target => {
            target.update();
            target.draw();
        });

        // 繪製準心
        drawCrosshair();

        if (isPlaying) {
            requestAnimationFrame(gameLoop);
        }
    }

    function startGame() {
        score = 0;
        timeLeft = 30;
        scoreEl.textContent = score;
        timerEl.textContent = timeLeft;
        isPlaying = true;

        targets = [];
        for (let i = 0; i < targetCount; i++) {
            targets.push(new Target());
        }

        overlay.style.display = 'none';

        // 倒數計時器
        clearInterval(timerInterval);
        timerInterval = setInterval(() => {
            timeLeft--;
            timerEl.textContent = timeLeft;

            if (timeLeft <= 0) {
                endGame();
            }
        }, 1000);

        requestAnimationFrame(gameLoop);
    }

    function endGame() {
        isPlaying = false;
        clearInterval(timerInterval);

        titleText.textContent = "訓練結束！";
        document.getElementById('sub-text').textContent = `你的最終得分為：${score} 分`;
        startBtn.textContent = "再試一次";
        overlay.style.display = 'flex';
    }
</script>

</body>
</html>
